{
  "manifest_version": 3,
  "name": "RADCOLLAB · eRad UID",
  "version": "1.0.3",
  "description": "A jóváhagyott eRad-vizsgálat UID-jának kiolvasása beteg- és vizsgálatválasztással.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "eRad UID átvétele",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none';"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
